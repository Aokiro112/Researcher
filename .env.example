# TAVILY_API_KEY=tvly-xxxxxxxxxxxx
# BRAVE_API_KEY=BSA-xxxxxxxxxxxx

# 2. LLM Providers (Optional: built-in synthesis runs automatically with zero keys!)
# OLLAMA_URL=http://localhost:11434
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# GEMINI_API_KEY=AIzaxxxxxxxxxxxx

# 3. Database (Optional: client-side localStorage handles zero-config local runs)
# DATABASE_URL=postgresql://openpplx:openpplx_secret@localhost:5432/openpplx

# 4. Redis Cache & Job Queues
# REDIS_URL=redis://localhost:6379
